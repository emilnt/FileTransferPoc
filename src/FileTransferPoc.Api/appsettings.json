{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": "data",
    "RetentionDays": 15,
    "SeedSampleData": false
  },
  "Maskinporten": {
    "Authority": null,
    "Issuer": "https://maskinporten-stub.local/",
    "Audience": null,
    "SigningKey": null,
    "RequiredScope": "esas:filer",
    "EnableStubIssuer": false
  },
  "Service": {
    "MaintenanceMode": false,
    "MaxConcurrentDownloads": 100,
    "RetryAfterSeconds": 30
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
